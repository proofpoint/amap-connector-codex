{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amap-spec/schemas/submit-request.schema.json",
  "title": "submit-request",
  "description": "agent -> runtime: an inert outbound request. amap-spec v3.0.0 (spec/contract.md §3). Agent-authored: this document's envelope stays CLOSED (additionalProperties:false) at every level per §7's v3.0.0 asymmetry — an unrecognized member here is a designed, legible `rejected` refusal, never a silent drop.",
  "type": "object",
  "required": ["contract_version", "req_id", "draft"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "2" },
    "req_id": {
      "type": "string",
      "minLength": 1,
      "description": "monotonic per namespace; filename-safe (path authority is the filename, not this field — §2, the filename-authority-for-paths obligation).",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?!\\n)$"
    },
    "agent_id": { "type": "string", "minLength": 1, "pattern": "^[^\u0000-\u001f\u007f]*(?!\\n)$" },
    "ts": { "type": "string", "minLength": 1, "pattern": "^[^\u0000-\u001f\u007f]*(?!\\n)$" },
    "in_reply_to": { "type": "string", "pattern": "^[^\u0000-\u001f\u007f]*(?!\\n)$" },
    "draft": {
      "type": "object",
      "required": ["to", "subject", "body_text"],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "one bare addr-spec per element (no display name, address list, quoted local part, comment, IP literal, or folding whitespace — deliberately narrower than RFC 5322: those forms are exactly what make allowlist evaluation non-mechanical). EAI/SMTPUTF8 is out of scope at this version.",
            "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_`{|}~.-]+@[A-Za-z0-9.-]+(?!\\n)$"
          },
          "minItems": 1
        },
        "cc": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_`{|}~.-]+@[A-Za-z0-9.-]+(?!\\n)$"
          }
        },
        "subject": { "type": "string", "pattern": "^[^\u0000-\u001f\u007f]*(?!\\n)$" },
        "body_text": { "type": "string" },
        "reply_to_message_id": { "type": ["string", "null"], "pattern": "^[^\u0000-\u001f\u007f]*(?!\\n)$" },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["filename", "media_type", "size_bytes", "sha256"],
            "additionalProperties": false,
            "properties": {
              "filename":   { "type": "string", "minLength": 1, "pattern": "^[^\u0000-\u001f\u007f]*(?!\\n)$" },
              "media_type": { "type": "string", "minLength": 1, "pattern": "^[^\u0000-\u001f\u007f]*(?!\\n)$" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "sha256":     { "type": "string", "pattern": "^[a-f0-9]{64}(?!\\n)$" }
            }
          }
        }
      }
    }
  }
}
