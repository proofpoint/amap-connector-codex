{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "deployment_id",
    "execution_id",
    "state"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "state": {
      "enum": [
        "stopped",
        "running",
        "unknown"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
